<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 10 1809 以降を対象とする -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>WallpaperChanger.Infrastructure</RootNamespace>
    <!-- ストア版のパッケージで、アプリを CPU ごとに発行するときに参照されるため（WallpaperChanger.UI.csproj と同じ） -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- 画像の合成に WPF の画像処理 (WIC) を使う。UseWPF は暗黙の using を変えるため、フレームワーク参照のみ追加する -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperChanger.Core\WallpaperChanger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      画面に表示される文言（例外のメッセージ・モニターの名前）。Strings.resx が既定（日本語）、Strings.en.resx が英語。
      ビルド時に厳密に型指定されたクラス（WallpaperChanger.Infrastructure.Resources.Strings）を生成する。
    -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedNamespace>WallpaperChanger.Infrastructure.Resources</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WallpaperChanger.Tests" />
    <!-- NSubstitute で internal インターフェースをモックするため -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>

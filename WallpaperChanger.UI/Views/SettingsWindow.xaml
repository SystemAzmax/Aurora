<Window x:Class="WallpaperChanger.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WallpaperChanger.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="壁紙チェンジャー - 設定"
        Icon="pack://application:,,,/WallpaperChanger;component/Resources/AppIcon.ico"
        Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- コードビハインドは持たない。DataContext と InitializeComponent は ISettingsWindowService が設定・呼び出す。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左側: モニター一覧 ===== -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="16,20,8,16">
            <DockPanel DockPanel.Dock="Top" Margin="8,0,0,12">
                <Button DockPanel.Dock="Right" Content="識別" Tag="&#xE7F4;" Style="{StaticResource IconButtonStyle}"
                        MinWidth="0" Margin="0" VerticalAlignment="Center"
                        ToolTip="各モニターの画面に番号を表示します"
                        Command="{Binding IdentifyMonitorsCommand}" />
                <TextBlock Text="モニター" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <Button DockPanel.Dock="Bottom" Content="モニターを再検出" Tag="&#xE72C;"
                    Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    Command="{Binding RefreshMonitorsCommand}" />

            <ListBox ItemsSource="{Binding Monitors}"
                     SelectedItem="{Binding SelectedMonitor}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonitorItemViewModel}">
                        <Grid Margin="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE7F4;" FontSize="28"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== 右側: 選択中モニターの設定 ===== -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8,20,24,4">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}">
                    <Run Text="{Binding SelectedMonitor.DisplayName, Mode=OneWay, FallbackValue=モニター未選択}" />
                </TextBlock>

                <!-- 壁紙フォルダ（1 枚表示 / 4 分割 / 16 分割をここで切り替え、同じ一覧でフォルダを編集する） -->
                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding HasSelectedMonitor}">
                    <StackPanel>
                        <TextBlock Text="壁紙フォルダ" Style="{StaticResource SectionTitleStyle}" />

                        <!-- 表示レイアウトの切り替え（狭いウィンドウでは折り返す） -->
                        <WrapPanel Margin="0,0,0,6">
                            <RadioButton GroupName="Layout" Margin="0,0,32,6" VerticalContentAlignment="Center"
                                         IsChecked="{Binding IsSingleImageLayout}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="48" Height="27" Margin="0,0,10,0" CornerRadius="3"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="1 枚表示" />
                                        <TextBlock Text="画面全体に 1 枚" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Layout" Margin="0,0,32,6" VerticalContentAlignment="Center"
                                         IsChecked="{Binding IsGridLayout}">
                                <StackPanel Orientation="Horizontal">
                                    <UniformGrid Width="48" Height="27" Margin="0,0,10,0" Rows="2" Columns="2">
                                        <Border Margin="0,0,1,1" CornerRadius="2,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="1,0,0,1" CornerRadius="0,2,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0,1,1,0" CornerRadius="0,0,0,2" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="1,1,0,0" CornerRadius="0,0,2,0" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </UniformGrid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="4 分割表示" />
                                        <TextBlock Text="2 × 2 で 4 枚を同時に表示" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Layout" Margin="0,0,32,6" VerticalContentAlignment="Center"
                                         IsChecked="{Binding IsGrid4x4Layout}">
                                <StackPanel Orientation="Horizontal">
                                    <UniformGrid Width="48" Height="27" Margin="0,0,10,0" Rows="4" Columns="4">
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Margin="0.5" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </UniformGrid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="16 分割表示" />
                                        <TextBlock Text="4 × 4 で 16 枚を同時に表示" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Layout" Margin="0,0,0,6" VerticalContentAlignment="Center"
                                         IsChecked="{Binding IsSpanLayout}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 2 台の画面（枠）に、1 枚の画像（帯）がまたがるアイコン -->
                                    <Grid Width="48" Height="27" Margin="0,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Margin="0,0,1,0" CornerRadius="2,0,0,2" BorderThickness="1"
                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Grid.Column="1" Margin="1,0,0,0" CornerRadius="0,2,2,0" BorderThickness="1"
                                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Border Grid.ColumnSpan="2" Margin="3,7" CornerRadius="1"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="スパン" />
                                        <TextBlock Text="複数のモニターにまたがって 1 枚を表示" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>

                        <TextBlock Text="{Binding FolderCaption}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 分割表示: 編集するマス（16 分割では区画）の選択 -->
                            <ListBox Grid.Column="0" Margin="0,0,16,0"
                                     ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}"
                                     Width="232" Height="136" Padding="0" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding IsSplitLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TileItemViewModel}">
                                        <Border CornerRadius="4" BorderThickness="1" Padding="8,6"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Position}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" ToolTip="{Binding Summary}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- フォルダ一覧（1 枚表示: モニターのフォルダ / 分割表示: 選択中のマス（区画）のフォルダ） -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding EditingTargetText}" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Visibility="{Binding IsSplitLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Grid>
                                    <ListBox ItemsSource="{Binding EditingFolders}" SelectedItem="{Binding SelectedFolder}"
                                             Height="112" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE8B7;" FontSize="14" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding EmptyFoldersMessage}" Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding EditingFolders.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                            <Button Content="追加" Tag="&#xE710;" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding AddFolderCommand}" />
                            <Button Content="削除" Tag="&#xE74D;" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding RemoveFolderCommand}" />
                            <CheckBox DockPanel.Dock="Right" Content="サブフォルダも検索する"
                                      IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- 分割表示の見た目（マスへの収め方・間隔・色） -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsSplitLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="マスへの収め方" Margin="0,0,0,6" />
                            <RadioButton GroupName="TileFit" Margin="0,0,0,6" IsChecked="{Binding IsTileFill}">
                                <StackPanel>
                                    <TextBlock Text="マスを埋める" />
                                    <TextBlock Text="マスいっぱいに拡大し、はみ出した部分は中央で切り抜きます" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="TileFit" IsChecked="{Binding IsTileFitWhole}">
                                <StackPanel>
                                    <TextBlock Text="全体を表示" />
                                    <TextBlock Text="写真の端が切れないよう画像全体をマスに収め、余白は「空きマス・余白の色」で塗ります" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </RadioButton>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <DataTemplate x:Key="TileColorTemplate" DataType="{x:Type vm:TileColorOption}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" Margin="0,0,8,0" CornerRadius="3" BorderThickness="1"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{Binding Brush}" />
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="間隔" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <!-- 動かしている間に何度も合成し直さないよう、止めてから反映する -->
                                    <Slider Width="200" VerticalAlignment="Center" Minimum="0" Maximum="{x:Static vm:SettingsViewModel.MaxTileGap}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                            Value="{Binding TileGap, Delay=500}" />
                                    <TextBlock Text="{Binding TileGapText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="間隔の色" VerticalAlignment="Center" Margin="0,10,16,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="200" Margin="0,10,0,0" HorizontalAlignment="Left"
                                          ItemsSource="{Binding TileGapColors}" SelectedItem="{Binding SelectedTileGapColor}"
                                          ItemTemplate="{StaticResource TileColorTemplate}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="空きマス・余白の色" VerticalAlignment="Center" Margin="0,10,16,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Width="200" Margin="0,10,0,0" HorizontalAlignment="Left"
                                          ItemsSource="{Binding EmptyTileColors}" SelectedItem="{Binding SelectedEmptyTileColor}"
                                          ItemTemplate="{StaticResource TileColorTemplate}" />
                            </Grid>
                        </StackPanel>

                        <!-- スパンの収め方（スパンを選んだモニターで共通） -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsSpanLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="収め方（スパンで共通）" Margin="0,0,0,6" />
                            <RadioButton GroupName="SpanFit" Margin="0,0,0,6" IsChecked="{Binding IsSpanFill}">
                                <StackPanel>
                                    <TextBlock Text="モニター全体を埋める" />
                                    <TextBlock Text="スパンを選んだモニター全体を覆うように拡大し、はみ出した部分は中央で切り抜きます" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="SpanFit" IsChecked="{Binding IsSpanFitWhole}">
                                <StackPanel>
                                    <TextBlock Text="全体を表示" />
                                    <TextBlock Text="画像全体がスパンを選んだモニター全体に収まるように拡大縮小し、余白は黒で表示します" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0"
                                       Text="モニターの配置（Windows の「ディスプレイ」設定の位置）に合わせて切り分けます。モニターの縁の幅は考慮しません。" />
                        </StackPanel>

                        <!-- 1 枚表示の表示方法（Windows の「調整方法」は全モニター共通のため、モニターごとに選べるようにする） -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsSingleImageLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="表示方法" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Width="240" VerticalAlignment="Center"
                                          ItemsSource="{Binding SingleImageFits}" DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedSingleImageFit}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedSingleImageFit.Description}" Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- プレビュー -->
                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding HasSelectedMonitor}">
                    <StackPanel>
                        <TextBlock Text="プレビュー（現在の壁紙）" Style="{StaticResource SectionTitleStyle}" />
                        <Border Height="220" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="プレビューを表示できません" Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibleConverter}}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding CurrentWallpaperPath}" Style="{StaticResource CaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,0"
                                   ToolTip="{Binding CurrentWallpaperPath}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="前の壁紙" Tag="&#xE892;" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding PreviousSelectedMonitorCommand}" />
                            <Button Content="次の壁紙" Tag="&#xE893;" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ChangeSelectedMonitorNowCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 切替設定（全モニター共通） -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="切替設定（全モニター共通）" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="切り替え間隔" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Width="88" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                     Text="{Binding IntervalValue, UpdateSourceTrigger=PropertyChanged, Delay=600}" />
                            <ComboBox Width="100" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding IntervalUnits}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedIntervalUnit}" />
                            <TextBlock Text="（1 分～24 時間）" Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding IntervalError}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding HasIntervalError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ScheduleStatusText}" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Tag" Value="&#xE769;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Tag" Value="&#xE768;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="全壁紙を更新" Tag="&#xE72C;" Style="{StaticResource AccentIconButtonStyle}"
                                    ToolTip="壁紙フォルダを読み込み直して、全モニターの壁紙を選び直します"
                                    Command="{Binding RefreshAllWallpapersCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ランダム設定 -->
                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding HasSelectedMonitor}">
                    <StackPanel>
                        <TextBlock Text="ランダム設定" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="スパンを選んだモニターで共通の設定です。" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10"
                                   Visibility="{Binding IsSpanLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <RadioButton GroupName="SelectionMode" Margin="0,0,0,6"
                                     IsChecked="{Binding IsRandomSelection}">
                            <StackPanel>
                                <TextBlock Text="ランダム" />
                                <TextBlock Text="フォルダ内の画像から無作為に選びます" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="SelectionMode" IsChecked="{Binding IsSequentialSelection}">
                            <StackPanel>
                                <TextBlock Text="順送り" />
                                <TextBlock Text="ファイルパスの順に 1 枚ずつ切り替えます" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- ほかのモニターの設定をコピー（買い替えたモニターなど、自動で引き継げない場合に使う） -->
                <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding HasSelectedMonitor}">
                    <StackPanel>
                        <TextBlock Text="ほかのモニターの設定をコピー" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10"
                                   Text="買い替えたモニターなどに、前のモニター（接続していないモニターを含む）の壁紙フォルダ・表示レイアウト・表示方法・選び方などをコピーします。同じ型番のモニターの接続先を変えた場合は、自動で引き継ぎます。" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="320" VerticalAlignment="Center"
                                      ItemsSource="{Binding CopySources}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedCopySource}" />
                            <Button Content="コピー" Tag="&#xE8C8;" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding CopySettingsCommand}" />
                        </StackPanel>
                        <TextBlock Text="コピーできる設定がありません（壁紙フォルダを設定したモニターがありません）"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                                   Visibility="{Binding CopySources.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}" />
                    </StackPanel>
                </Border>

                <!-- 表示しない画像（アプリ全体の設定） -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="表示しない画像（全モニター共通）" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10"
                                   Text="トレイのメニューの「この画像を表示しない」で指定した画像です。壁紙フォルダにあっても表示しません。" />
                        <Grid>
                            <ListBox ItemsSource="{Binding ExcludedImages}" SelectedItem="{Binding SelectedExcludedImage}"
                                     Height="112" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE8B9;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="表示しない画像はありません" Style="{StaticResource CaptionTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding ExcludedImages.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="表示に戻す" Tag="&#xE7A7;" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding RestoreExcludedImageCommand}" />
                            <Button Content="場所を開く" Tag="&#xE838;" Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ShowExcludedImageInFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 起動・ログ（アプリ全体の設定） -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="起動とログ" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox IsChecked="{Binding StartWithWindows}">
                            <StackPanel>
                                <TextBlock Text="Windows の起動時に自動的に開始する" />
                                <TextBlock Text="サインインすると、タスクトレイに常駐して壁紙の自動切り替えを始めます"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </CheckBox>
                        <DockPanel Margin="0,16,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="ログフォルダを開く" Tag="&#xE838;"
                                    Style="{StaticResource IconButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding OpenLogFolderCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ログ" />
                                <TextBlock Text="{Binding LogDirectory, StringFormat=動作の記録を {0} に保存しています（14 日分）}"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== ステータスバー ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="24,8"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <!-- 切り替え中は進み具合を表示する（モニターが多いと終わるまで時間がかかるため） -->
                <ProgressBar DockPanel.Dock="Left" Width="96" Margin="0,0,12,0" VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsChangingWallpaper}"
                             Visibility="{Binding IsChangingWallpaper, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                            <Setter Property="Text" Value="{Binding StatusMessage}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <!-- 後に書いたトリガーが優先される。切り替え中は、直前のエラーの色を引き継がない -->
                                <DataTrigger Binding="{Binding IsChangingWallpaper}" Value="True">
                                    <Setter Property="Text" Value="{Binding ChangeProgressText}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>

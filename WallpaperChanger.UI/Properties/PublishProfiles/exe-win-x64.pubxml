<?xml version="1.0" encoding="utf-8"?>
<!--
  exe 版（パッケージなし）の Self-contained 配布用（.NET ランタイム未導入の PC でも動作する）。
  dotnet publish WallpaperChanger.UI -p:PublishProfile=exe-win-x64
  ストア版のパッケージには win-x86 / win-x64 / win-arm64.pubxml が使われるため、こちらは影響しない（docs/BuildGuide.md を参照）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF はトリミング非対応 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>

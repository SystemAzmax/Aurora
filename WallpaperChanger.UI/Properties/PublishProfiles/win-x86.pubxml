<?xml version="1.0" encoding="utf-8"?>
<!--
  ストア版のパッケージ（WallpaperChanger.Package）用。パッケージのプロジェクトが win-x86 のパッケージを作るときに使う。
  Store には .NET のフレームワーク パッケージが無いため、.NET ランタイムを同梱する（Self-contained）。
  パッケージはファイルを展開してから実行するため、単一ファイルにはしない。
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- WPF はトリミング非対応 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>

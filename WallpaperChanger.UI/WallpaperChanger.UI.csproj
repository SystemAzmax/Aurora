<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>WallpaperChanger.UI</RootNamespace>
    <AssemblyName>WallpaperChanger</AssemblyName>
    <AssemblyTitle>Aurora Wallpaper Changer</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <!-- Main は Program.cs に定義する（App.xaml はリソース定義のみ） -->
    <StartupObject>WallpaperChanger.UI.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- EnableDefaultApplicationDefinition=false により App.xaml は Page として扱われる -->
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 「ライセンス情報」で開く、使用しているソフトウェアのライセンス表示。
         パッケージを更新したときの作り直し方は docs/BuildGuide.md を参照 -->
    <Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      画面の文言。Strings.resx が既定（日本語）、Strings.en.resx が英語。
      ビルド時に厳密に型指定されたクラス（WallpaperChanger.UI.Resources.Strings）を生成し、XAML からは x:Static で参照する。
    -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedNamespace>WallpaperChanger.UI.Resources</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperChanger.Core\WallpaperChanger.Core.csproj" />
    <ProjectReference Include="..\WallpaperChanger.Infrastructure\WallpaperChanger.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WallpaperChanger.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    WPF は XAML をコンパイルするため、先に一時プロジェクト（*_wpftmp.csproj）で C# をコンパイルする。
    リソースのクラスは通常その後で生成されるため、一時プロジェクトでもコンパイルの前に生成し、XAML と C# から参照できるようにする。
  -->
  <Target Name="GenerateStringsBeforeCompile" BeforeTargets="CoreCompile" DependsOnTargets="PrepareResourceNames;CoreResGen" />

</Project>
